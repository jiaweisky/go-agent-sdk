# nmake build file for Windows (MSVC NMAKE).
#
# Run from a "Developer Command Prompt for VS", or with nmake on PATH:
#
#   nmake -f Makefile.nmake            # build examples and commands
#   nmake -f Makefile.nmake test
#   nmake -f Makefile.nmake VERSION=1.2.3 cmds
#   nmake -f Makefile.nmake bin\chat.exe
#   nmake -f Makefile.nmake release
#
# This file covers the local build/check targets and the release packaging.
# `release` matches the POSIX Makefile: Windows ships tar, and
# scripts/versionstamp.ps1 writes sha256sums.txt in the same format. The archive
# carries Windows binaries, so POSIX file modes do not apply.
#
# Unlike the GNU Makefile, NMAKE cannot expand `$(shell ...)` or glob sources,
# so sources are not tracked and every target rebuilds (the Go build cache keeps
# that cheap). Macros use !IFNDEF so the environment can override them like the
# POSIX Makefile's `?=`, and a target with commands depends on FORCE so it is
# never skipped when a same-named file or directory exists (e.g. examples/).
#
# Version stamping matches the POSIX Makefile: an exact tag on HEAD is a release
# version, anything else is dev-<short-sha>[-dirty], and outside git it is
# "dev". The git query lives in scripts/versionstamp.ps1 because NMAKE cannot
# run it inline; keep it in sync with the block in Makefile. VERSION overrides
# the derived version and is interpolated into commands, so only pass trusted
# values.
#
# Note: `fmt-check` assumes LF line endings. With `core.autocrlf=true` (the Git
# for Windows default) gofmt reports every file as unformatted; set
# `git config core.autocrlf input` and re-checkout, or run this check via WSL.

!IFNDEF GO
GO = go
!ENDIF
!IFNDEF GOFMT
GOFMT = gofmt
!ENDIF
!IFNDEF GOOS
GOOS = windows
!ENDIF
!IFNDEF BIN
BIN = bin
!ENDIF
!IFNDEF DIST
DIST = dist
!ENDIF
!IFNDEF CONFIG
CONFIG = cmd\agentd\agentd.yaml
!ENDIF
!IFNDEF GOLANGCI_LINT_VERSION
GOLANGCI_LINT_VERSION = v2.12.2
!ENDIF
!IFNDEF GOLANGCI_LINT
GOLANGCI_LINT = $(GO) run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$(GOLANGCI_LINT_VERSION)
!ENDIF

# A non-Windows GOOS drops the suffix, like the POSIX Makefile's EXE. GOOS from
# the environment or the command line is inherited by go build, so
# `nmake GOOS=linux cmds` cross-compiles.
!IF "$(GOOS)" == "windows"
EXE = .exe
!ELSE
EXE =
!ENDIF

POWERSHELL = powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File
VERSIONSTAMP = $(POWERSHELL) scripts\versionstamp.ps1
# NMAKE does not export makefile-defined macros and drops empty command-line
# ones, so a marker passed through cmd tells the stamp helper that VERSION was
# set (possibly empty, as in `make VERSION=`) rather than unset. `call set` is
# used because a recipe line whose first command is `set` loses the rest of the
# line.
!IFDEF VERSION
VERSION_ENV = call set "VERSION_SET=1" &
!ENDIF

# NMAKE has no addprefix, so the binary list repeats the example names.
EXAMPLE_BINS = $(BIN)\chat$(EXE) $(BIN)\tool$(EXE) $(BIN)\notesmcp$(EXE) $(BIN)\weathermcp$(EXE) $(BIN)\a2a-embedded$(EXE) $(BIN)\agentd-client$(EXE)
CMD_BINS = $(BIN)\agentd$(EXE)

all: examples cmds

examples: $(EXAMPLE_BINS)

cmds: $(CMD_BINS)

_bin: FORCE
	@if not exist "$(BIN)" mkdir "$(BIN)"

# Dev builds are stamped dev-<commit>[-dirty]; releases are stamped with the
# exact git tag, same as the POSIX Makefile. The trailing check catches a stamp
# helper that failed before the loop body could run, which would otherwise leave
# the build silently un-stamped.
$(BIN)\agentd$(EXE): _bin FORCE
	@$(VERSION_ENV) for /f "usebackq delims=" %v in (`$(VERSIONSTAMP) ldflag`) do @$(GO) build -ldflags "%v" -o "$@" .\cmd\agentd
	@if not exist "$@" (echo versionstamp failed, see $(VERSIONSTAMP) 1>&2 & exit /b 1)

$(BIN)\chat$(EXE): _bin FORCE
	$(GO) build -o "$@" .\examples\chat

$(BIN)\tool$(EXE): _bin FORCE
	$(GO) build -o "$@" .\examples\tool

$(BIN)\notesmcp$(EXE): _bin FORCE
	$(GO) build -o "$@" .\examples\notesmcp

$(BIN)\weathermcp$(EXE): _bin FORCE
	$(GO) build -o "$@" .\examples\weathermcp

$(BIN)\a2a-embedded$(EXE): _bin FORCE
	$(GO) build -o "$@" .\examples\a2a-embedded

$(BIN)\agentd-client$(EXE): _bin FORCE
	$(GO) build -o "$@" .\examples\agentd-client

# Run agentd with the git-ignored local config. Override with CONFIG=path.
agentd: $(BIN)\agentd$(EXE) FORCE
	"$(BIN)\agentd$(EXE)" --config "$(CONFIG)"

# Run the chat example with examples/chat as its working directory, so its .env,
# .config and .data stay under examples/chat instead of the launch directory.
chat: $(BIN)\chat$(EXE) FORCE
	"$(BIN)\chat$(EXE)" -C examples\chat

# Run the embedded-A2A example: multi-turn context plus an input-required round
# trip, then keeps serving until Ctrl+C.
a2a-embedded: $(BIN)\a2a-embedded$(EXE) FORCE
	"$(BIN)\a2a-embedded$(EXE)"

fmt: FORCE
	$(GOFMT) -w .

# Fail if any Go source is not gofmt-clean, listing every offender like the
# POSIX Makefile does. The loop is parenthesized so the final `if` runs after it
# (an unparenthesized `& if` would become part of the loop body), and `call set`
# keeps the flag in this cmd; `set` alone would swallow the rest of the line.
fmt-check: FORCE
	@call set "BAD=" & (for /f "delims=" %f in ('$(GOFMT) -l .') do @(echo unformatted file: %f & call set "BAD=1")) & if defined BAD exit /b 1

vet: FORCE
	$(GO) vet ./...

test: FORCE
	$(GO) test ./...

lint: fmt-check vet FORCE

# Verify the internal/ boundary: no exported pkg/... symbol may reference an
# internal/ type (AST check), and the external probe module must build.
check-boundary: FORCE
	$(GO) run testdata\boundarycheck.go
	copy /y go.sum testdata\external\go.sum >NUL
	@cd testdata\external && $(GO) build -o NUL .\...
	@echo internal boundary OK

golangci: FORCE
	$(GOLANGCI_LINT) run ./...

# Build the commands stripped and with -trimpath, then package
# go-agent-sdk-<version>.tar.gz plus sha256sums.txt into $(DIST), like the POSIX
# Makefile. A dev stamp never ships: releasecheck fails unless HEAD is exactly
# tagged and clean. NMAKE cannot keep a shell across lines, so the version is
# re-derived per line.
release: FORCE
	@$(VERSION_ENV) $(VERSIONSTAMP) releasecheck
	@if exist "$(DIST)" rmdir /s /q "$(DIST)"
	@for /f "usebackq delims=" %v in (`$(VERSIONSTAMP) version`) do @mkdir "$(DIST)\go-agent-sdk-%v"
	@for /f "usebackq delims=" %v in (`$(VERSIONSTAMP) version`) do @$(GO) build -trimpath -ldflags "-s -w -X main.version=%v" -o "$(DIST)\go-agent-sdk-%v\agentd$(EXE)" .\cmd\agentd
	@for /f "usebackq delims=" %v in (`$(VERSIONSTAMP) version`) do @tar -czf "$(DIST)\go-agent-sdk-%v.tar.gz" -C "$(DIST)" "go-agent-sdk-%v"
	@for /f "usebackq delims=" %v in (`$(VERSIONSTAMP) version`) do @$(POWERSHELL) scripts\release-dist.ps1 rmtree "$(DIST)\go-agent-sdk-%v"
	@$(POWERSHELL) scripts\release-dist.ps1 sha256sums "$(DIST)"
	@for /f "usebackq delims=" %v in (`$(VERSIONSTAMP) version`) do @echo release archive in $(DIST)/ (%v)

clean: FORCE
	@if exist "$(BIN)" rmdir /s /q "$(BIN)"
	@if exist "$(DIST)" rmdir /s /q "$(DIST)"

# Print the version and kind that the next build would stamp, e.g.
# "dev-abc1234-dirty (dev)" or "1.2.3 (release)".
version: FORCE
	@$(VERSION_ENV) $(VERSIONSTAMP)

FORCE:
