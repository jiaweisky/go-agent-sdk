# Copy to .env (git-ignored) and fill in. These are read by the examples.

# ── Provider API keys ────────────────────────────────────
# A model is offered only when its provider key is set; the model catalog
# (examples/internal/util/catalog.go) maps each model to its provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── chat example: local weather MCP server ───────────────
# Path to the server entry script; $VAR and a leading ~ are expanded.
# https://github.com/Le-dawn/mcp-China-weather-server
WEATHER_MCP=
# AMap (Gaode) developer API key; the weather MCP server uses it to call AMap.
AMAP_API_KEY=
