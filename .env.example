# Copy to .env (git-ignored) and fill in. These are read by the examples.

# ── Provider ─────────────────────────────────────────────
# openai (default) | anthropic | openai-compatible | gemini
OPENCODE_PROVIDER=openai
# Provider id for openai-compatible endpoints (e.g. deepseek)
OPENCODE_PROVIDER_ID=
# Provider base URL (optional; e.g. https://api.deepseek.com/v1)
OPENCODE_BASE_URL=
# API key. OPENAI_API_KEY is also honored for openai, ANTHROPIC_API_KEY for
# anthropic. openai-compatible has no fallback, so this is required for it.
OPENCODE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Model (required) ─────────────────────────────────────
# Provider-specific; no default. e.g. gpt-4o, claude-sonnet-4-20250514, deepseek-v4-flash
OPENCODE_MODEL=gpt-4o
# Model context/output limits, in tokens. Set these to enable auto-compaction.
OPENCODE_CONTEXT_LIMIT=
OPENCODE_OUTPUT_LIMIT=

# ── chat example: local weather MCP server ───────────────
OPENCODE_WEATHER_MCP=
# AMap (Gaode) developer API key; the weather MCP server uses it to call AMap.
AMAP_API_KEY=
