.DS_Store

# Build and test artifacts
/bin/
*.test
*.out

# Local environment / secrets
.env
.env.*
!.env.example

# Example state (see examples/internal/util.Client)
examples/*/.data/

# A2A inbound attachments (written under the workspace by the server)
.a2a/

# Local a2aserve config (contains credentials); see cmd/a2aserve/a2aserve.example.yaml
a2aserve.yaml

# Built command binaries at the repo root (never commit)
/a2aserve
/agentserve
