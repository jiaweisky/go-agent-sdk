.DS_Store

# Build and test artifacts
/bin/
/dist/
*.test
*.out

# Local environment / secrets
.env
.env.*
!.env.example

# Example state (see examples/internal/util.Client)
examples/*/.data/

# A2A inbound attachments (written under the workspace by the server)
.a2a/

# Local serve configs (contain credentials); see the *.example.yaml templates
agentd.yaml

# Built command/example binaries at the repo root (a manual `go build ./cmd/...`
# or `./examples/...` writes here; the Makefile builds into /bin instead)
/agentd
/agentd.exe
/agentd-client
/agentd-client.exe
/a2a-embedded
/a2a-embedded.exe
/chat
/chat.exe
/tool
/tool.exe
/notesmcp
/notesmcp.exe

# External probe module go.sum (generated by make check-boundary)
/testdata/external/go.sum
/testdata/external/external
